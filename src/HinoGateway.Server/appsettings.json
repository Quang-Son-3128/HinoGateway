{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "File": {
      "RetainedFileCountLimit": 14,
      "FileSizeLimitMb": 32
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:2000"
      }
    }
  },
  "Security": {
    "Enabled": false,
    "RequireHttps": true,
    "ApiKeys": []
  },
  "Commands": {
    "RateLimitPerSecond": 20,
    "QueueCapacity": 256,
    "WorkerCount": 8,
    "TimeoutMs": 10000
  },
  "Audit": {
    "QueueCapacity": 4096,
    "BatchSize": 100,
    "BatchWindowMs": 20,
    "RetentionDays": 90,
    "MaxFiles": 180,
    "MaxTotalBytes": 2147483648
  },
  "History": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "RetentionDays": 7,
    "MaxFiles": 14,
    "MaxTotalBytes": 2147483648,
    "Path": ""
  },
  "Data": {
    "Root": "",
    "SeedDemo": false
  },
  "Health": {
    "Components": {
      "HeartbeatTimeoutSeconds": 30,
      "RestartWindowSeconds": 300,
      "MaxRestartsInWindow": 3,
      "RecoveryGraceSeconds": 15
    }
  },
  "Config": {
    "SecretsPath": "hino.secrets.json"
  },
  "AllowedHosts": "*"
}
