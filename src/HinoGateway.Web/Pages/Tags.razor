@page "/tags"
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Nav

<PageTitle>HinoGateway — Tags</PageTitle>

<div class="page-head">
    <h1>Tag Database</h1>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="NewFolder">New folder</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="NewTag">New tag</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PublishedWithChanges"
               OnClick="ApplyAsync" Disabled="_busy">Apply to engine</MudButton>
</div>

@if (_devices.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-3" Variant="Variant.Outlined">
        No connections yet — create one on the <MudLink Href="connections">Connections</MudLink> page to read
        values from a device. Memory and expression tags need no connection and can be created right away.
    </MudAlert>
}

<MudGrid Spacing="3">
    <MudItem xs="12" md="4" lg="3">
        <MudPaper Class="pa-2" Elevation="0" Outlined>
            <MudText Typo="Typo.caption" Class="hino-nav-section">Folders</MudText>
            <MudTreeView T="string" Items="_tree" Hover Dense
                         SelectedValue="_selectedGroupId" SelectedValueChanged="OnSelectGroup">
                <ItemTemplate>
                    <MudTreeViewItem Value="@context.Value" Items="@context.Children" Text="@context.Text"
                                     Icon="@context.Icon" @bind-Expanded="@context.Expanded" />
                </ItemTemplate>
            </MudTreeView>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8" lg="9">
        <div class="d-flex align-center mb-2" style="gap:.4rem">
            <MudIcon Icon="@(_selectedGroupId == RootId ? Icons.Material.Filled.AccountTree : Icons.Material.Filled.Folder)"
                     Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1" Style="font-family:monospace">@CurrentPathLabel</MudText>
            <MudSpacer />
            @if (_selectedGroupId != RootId)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.DriveFileRenameOutline"
                           OnClick="EditFolder">Rename / move</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="DeleteFolderAsync">Delete folder</MudButton>
            }
        </div>

        @if (_folderEdit is not null)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="0" Outlined Style="border-left:3px solid var(--mud-palette-primary)">
                <MudText Typo="Typo.h6" Class="mb-3">@(_folderIsNew ? "New folder" : $"Edit folder '{_folderEdit.Name}'")</MudText>
                <div class="d-flex flex-wrap align-center" style="gap:1rem">
                    <MudTextField T="string" @bind-Value="_folderEdit.Name" Label="Folder name"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:14rem" />
                    <MudSelect T="string" @bind-Value="_folderParentId" Label="Inside"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:16rem">
                        <MudSelectItem T="string" Value="@RootId">(root)</MudSelectItem>
                        @foreach (var g in FolderChoicesExcludingSubtree(_folderIsNew ? null : _folderEdit.Id))
                        {
                            <MudSelectItem T="string" Value="@g.Id">@GroupPath(g.Id)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveFolderAsync" Disabled="_busy">Save</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="() => _folderEdit = null">Cancel</MudButton>
                </div>
            </MudPaper>
        }

        <MudPaper Elevation="0" Outlined>
            <MudTable Items="TagsInSelectedGroup" Dense Hover Elevation="0" RowStyleFunc="TagRowStyle">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Kind</MudTh>
                    <MudTh>Connection</MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Unit</MudTh>
                    <MudTh>Scan</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name" Class="mono">@context.Name</MudTd>
                    <MudTd DataLabel="Kind">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@KindColour(context.Kind)">@KindLabel(context.Kind)</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Connection">
                        @if (context.Kind == TagKind.Device)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@context.DeviceId</MudChip>
                        }
                        else
                        {
                            <span style="opacity:.35">—</span>
                        }
                    </MudTd>
                    @* One column, three meanings: the address read, the formula computed, or the value held. *@
                    <MudTd DataLabel="Source" Class="mono" Style="max-width:22rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                        <MudTooltip Text="@SourceText(context)"><span>@SourceText(context)</span></MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Type"><span class="mono" style="font-size:.8rem;opacity:.8">@context.DataType</span></MudTd>
                    <MudTd DataLabel="Unit">@context.Unit</MudTd>
                    <MudTd DataLabel="Scan">
                        @if (context.ScanIntervalMs > 0)
                        {
                            <MudTooltip Text="This tag has a rate of its own; the rest follow the connection.">
                                <span class="mono" style="font-size:.78rem;color:var(--hino-warn)">@FormatRate(context.ScanIntervalMs)</span>
                            </MudTooltip>
                        }
                        else
                        {
                            <span style="opacity:.35;font-size:.78rem">—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Description" Style="opacity:.7;font-size:.85rem">@context.Description</MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="() => EditTag(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteTagAsync(context)" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Class="pa-4" Style="opacity:.5">No tags in this folder.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>

        @if (_tagEdit is not null)
        {
            <MudPaper Class="pa-4 mt-3" Elevation="0" Outlined Style="border-left:3px solid var(--mud-palette-primary)">
                <MudText Typo="Typo.h6" Class="mb-3">
                    <MudIcon Icon="@(_tagIsNew ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)" Size="Size.Small" Class="me-1" />
                    @(_tagIsNew ? "New tag" : $"Edit {_tagEdit.Name}")
                </MudText>
                <div class="d-flex flex-wrap" style="gap:1rem">
                    <MudTooltip Text="@KindHelp">
                        <MudSelect T="TagKind" @bind-Value="_tagEdit.Kind" Label="Tag kind"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:11rem">
                            @foreach (var kind in Enum.GetValues<TagKind>())
                            {
                                <MudSelectItem T="TagKind" Value="@kind">@KindLabel(kind)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTooltip>
                    <MudTextField T="string" @bind-Value="_tagEdit.Name" Label="Name"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:12rem" />
                    <MudSelect T="string" @bind-Value="_tagGroupId" Label="Folder"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:14rem">
                        <MudSelectItem T="string" Value="@RootId">(root)</MudSelectItem>
                        @foreach (var g in _groups.OrderBy(x => GroupPath(x.Id)))
                        {
                            <MudSelectItem T="string" Value="@g.Id">@GroupPath(g.Id)</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_tagEdit.Kind == TagKind.Device)
                    {
                        <MudSelect T="string" @bind-Value="_tagEdit.DeviceId" Label="Connection"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:12rem">
                            @foreach (var d in _devices)
                            {
                                <MudSelectItem T="string" Value="@d.Id">@d.Id (@d.Driver)</MudSelectItem>
                            }
                        </MudSelect>
                        @* Placeholder and hint come from the driver behind the chosen connection: an S7
                           address is nothing like a Modbus one, and a shared example teaches neither. *@
                        <MudTextField T="string" @bind-Value="_tagEdit.Address" Label="Address"
                                      Placeholder="@AddressPlaceholder" HelperText="@EditDescriptor.AddressHelp"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:10rem" />
                    }
                    <MudSelect T="DataType" @bind-Value="_tagEdit.DataType" Label="Data type"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:9rem">
                        @foreach (var dt in AllowedTypes)
                        {
                            <MudSelectItem T="DataType" Value="@dt">@dt</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" @bind-Value="_tagEdit.Unit" Label="Unit"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:6rem" />
                    <MudTextField T="string" @bind-Value="_tagEdit.Description" Label="Description" Placeholder="What this tag measures"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:18rem;flex-grow:1" />
                    @if (_tagEdit.Kind != TagKind.Expression)
                    {
                        <MudTooltip Text="Safety interlock: REST and IEC-104 controls are rejected until this is enabled for this exact tag.">
                            <MudSwitch T="bool" @bind-Value="_tagEdit.AllowWrite" Color="Color.Warning"
                                       Label="Allow control/write" Class="mt-2" />
                        </MudTooltip>
                        @if (_tagEdit.AllowWrite && _tagEdit.DataType is not DataType.Bool and not DataType.String)
                        {
                            <MudNumericField T="double?" @bind-Value="_tagEdit.WriteMin" Label="Write minimum" HideSpinButtons
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:8rem" />
                            <MudNumericField T="double?" @bind-Value="_tagEdit.WriteMax" Label="Write maximum" HideSpinButtons
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:8rem" />
                        }
                    }
                    @* Scaling is applied by the device worker to a raw reading, so it exists only for a
                       device tag: a formula does its own arithmetic and a memory tag holds what was written. *@
                    @if (_tagEdit.Kind == TagKind.Device)
                    {
                        <MudNumericField T="double" @bind-Value="_tagEdit.Scale" Label="Scale" HideSpinButtons
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:7rem" />
                        <MudNumericField T="double" @bind-Value="_tagEdit.Offset" Label="Offset" HideSpinButtons
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:7rem" />
                        <MudTooltip Text="@ScanRateHelp">
                            <MudNumericField T="int" @bind-Value="_tagEdit.ScanIntervalMs" Label="Scan rate (ms)"
                                             Min="0" Max="86400000" HideSpinButtons
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:9rem" />
                        </MudTooltip>
                        <MudTooltip Text="For cumulative registers (energy, run hours): a reading lower than the highest one so far is refused and the previous value kept, because on such a register a drop is a bad read. A meter that is genuinely replaced or reset stays held until you untick this or restart the gateway.">
                            <MudSwitch T="bool" @bind-Value="_tagEdit.Monotonic" Color="Color.Primary"
                                       Label="Only increases (counter)" Class="mt-2" />
                        </MudTooltip>
                    }
                    @if (_tagEdit.Kind == TagKind.Memory)
                    {
                        <MudTooltip Text="What the tag holds before anything is written to it. Leave it empty and the tag starts Bad with 'never written' — honest for a setpoint nobody has set yet.">
                            <MudTextField T="string" @bind-Value="_tagEdit.InitialValue" Label="Initial value" Placeholder="0"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:10rem" />
                        </MudTooltip>
                        <MudTooltip Text="Keep the value across a restart, in a file beside the project. Off by default on purpose: a gateway restarts because something went wrong, and a control setpoint that silently restores itself can put a plant back into a state nobody re-authorised.">
                            <MudSwitch T="bool" @bind-Value="_tagEdit.Retentive" Color="Color.Primary"
                                       Label="Keep value across restart" Class="mt-2" />
                        </MudTooltip>
                    }
                    @if (_tagEdit.Kind == TagKind.Expression)
                    {
                        <MudSelect T="EvalMode" @bind-Value="_tagEdit.EvalMode" Label="Recompute"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:12rem">
                            <MudSelectItem T="EvalMode" Value="@EvalMode.Scan">On a fixed period</MudSelectItem>
                            <MudSelectItem T="EvalMode" Value="@EvalMode.OnChange">When an input changes</MudSelectItem>
                        </MudSelect>
                        @if (_tagEdit.EvalMode == EvalMode.Scan)
                        {
                            <MudTooltip Text="How often the formula is evaluated. 0 means the default of 1 second; the fastest allowed is 50 ms.">
                                <MudNumericField T="int" @bind-Value="_tagEdit.ScanIntervalMs" Label="Every (ms)"
                                                 Min="0" Max="86400000" HideSpinButtons
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:9rem" />
                            </MudTooltip>
                        }
                    }
                </div>

                @if (_tagEdit.Kind == TagKind.Device)
                {
                    var driver = EditDescriptor;
                    @if (!string.IsNullOrWhiteSpace(driver.AddressSyntaxHelp))
                    {
                        <MudAlert Severity="Severity.Info" Dense Class="mt-3" Variant="Variant.Outlined">
                            <b>@DriverLabel(driver):</b> @driver.AddressSyntaxHelp
                            @if (driver.AddressExamples.Count > 0)
                            {
                                <span> e.g. </span>
                                @for (var i = 0; i < driver.AddressExamples.Count; i++)
                                {
                                    @if (i > 0)
                                    {
                                        <span>, </span>
                                    }
                                    <code>@driver.AddressExamples[i]</code>
                                }
                            }
                        </MudAlert>
                    }
                    @* The driver refuses a type it cannot decode, costing that tag its data. Better to
                       say so here than to let the apply drop it. *@
                    @if (driver.SupportedTypes.Count > 0 && !driver.SupportedTypes.Contains(_tagEdit.DataType))
                    {
                        <MudAlert Severity="Severity.Warning" Dense Class="mt-2" Variant="Variant.Outlined">
                            @($"{DriverLabel(driver)} cannot read {_tagEdit.DataType} — this tag will be dropped when the configuration is applied.")
                        </MudAlert>
                    }
                }

                @if (_tagEdit.Kind == TagKind.Expression)
                {
                    <MudTextField T="string" Value="@(_tagEdit.Expression ?? "")" ValueChanged="OnExpressionChanged"
                                  Label="Formula" Lines="3" Class="mt-3 mono" Immediate="false"
                                  Placeholder="({Plant/P1} + {Plant/P2}) / 1000"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Error="@(_expressionError is not null)" ErrorText="@_expressionError"
                                  HelperText="Tags in braces, e.g. {Plant/Line 1/Power}. Checked by the gateway when you leave the box." />

                    @if (_expressionUnknown.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense Class="mt-2" Variant="Variant.Outlined">
                            No such tag: @string.Join(", ", _expressionUnknown)
                        </MudAlert>
                    }
                    else if (_expressionError is null && _expressionReads.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mt-1 d-block" Style="opacity:.7">
                            Reads: @string.Join(", ", _expressionReads)
                            @if (_expressionPreview is not null)
                            {
                                <span> · now: <b class="mono">@_expressionPreview</b></span>
                            }
                        </MudText>
                    }
                }

                <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-2 d-block">
                    Runtime tag id: <code>@PreviewPath</code>
                    @if (_tagEdit.ScanIntervalMs > 0)
                    {
                        <span> · read every <b>@FormatRate(_tagEdit.ScanIntervalMs)</b>@ConnectionRateNote</span>
                    }
                </MudText>
                <div class="d-flex mt-3" style="gap:.6rem">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveTagAsync" Disabled="_busy">Save</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="() => _tagEdit = null">Cancel</MudButton>
                </div>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    // MudSelect/TreeView bind string (not string?) most ergonomically, so the root is a sentinel.
    private const string RootId = "";

    private List<TagGroupDto> _groups = new();
    private List<TagDto> _tags = new();
    private List<DeviceDto> _devices = new();
    private List<DriverDescriptor> _descriptors = new();
    private List<TreeItemData<string>> _tree = new();
    private string _selectedGroupId = RootId;

    private TagGroupDto? _folderEdit;
    private string _folderParentId = RootId;
    private bool _folderIsNew;

    private TagDto? _tagEdit;
    private string _tagGroupId = RootId;
    private bool _tagIsNew;

    private bool _busy;
    private string? _highlightTagId;

    // Whatever the gateway said about the formula currently in the editor. Checked server-side by the
    // same compiler the engine runs, so the editor can never accept something the engine refuses.
    private string? _expressionError;
    private List<string> _expressionReads = new();
    private List<string> _expressionUnknown = new();
    private string? _expressionPreview;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        SelectTagFromQuery();
    }

    // Deep link from the Live page: /tags?select=<runtime tag path> jumps to the
    // tag's folder and highlights its row.
    private void SelectTagFromQuery()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var idx = pair.IndexOf('=');
            if (idx <= 0 || !pair[..idx].Equals("select", StringComparison.OrdinalIgnoreCase))
                continue;

            var path = Uri.UnescapeDataString(pair[(idx + 1)..].Replace('+', ' '));
            var tag = _tags.FirstOrDefault(t => t.Path == path);
            if (tag is not null)
            {
                _selectedGroupId = tag.GroupId ?? RootId;
                _highlightTagId = tag.Id;
            }
            return;
        }
    }

    // --- what the driver behind a tag says about itself -----------------------

    private DriverDescriptor Descriptor(string? deviceId)
    {
        var driver = _devices.FirstOrDefault(d => d.Id == deviceId)?.Driver;
        return _descriptors.FirstOrDefault(x => string.Equals(x.DriverType, driver, StringComparison.OrdinalIgnoreCase))
            ?? DriverDescriptor.Minimal(driver ?? "");
    }

    /// <summary>The driver of the connection currently chosen in the editor.</summary>
    private DriverDescriptor EditDescriptor => Descriptor(_tagEdit?.DeviceId);

    private static string DriverLabel(DriverDescriptor d) =>
        string.IsNullOrWhiteSpace(d.DisplayName) ? d.DriverType : d.DisplayName;

    private string AddressPlaceholder =>
        EditDescriptor.AddressExample
        ?? EditDescriptor.AddressExamples.FirstOrDefault()
        ?? "40001 / sine";

    /// <summary>
    /// Only the types the driver can decode, for a device tag. A type it cannot read costs that tag
    /// its data at apply time, so it has no business being offered here.
    ///
    /// <para>
    /// A tag already stored with a type outside that list stays in the list: dropping it would make
    /// the select show something the tag is not, and quietly rewrite it on the next save.
    /// </para>
    /// </summary>
    private IEnumerable<DataType> AllowedTypes
    {
        get
        {
            var all = Enum.GetValues<DataType>();
            if (_tagEdit is null || _tagEdit.Kind != TagKind.Device)
                return all;

            var supported = EditDescriptor.SupportedTypes;
            return supported.Count == 0
                ? all
                : all.Where(t => supported.Contains(t) || t == _tagEdit.DataType);
        }
    }

    private string TagRowStyle(TagDto t, int _) =>
        t.Id == _highlightTagId
            ? "background:rgba(59,130,246,.16);box-shadow:inset 3px 0 0 var(--mud-palette-primary)"
            : "";

    private async Task LoadAsync()
    {
        // A refused read (no API key yet) must leave a page that renders and can be asked for one.
        try
        {
            _groups = await Http.GetFromJsonAsync<List<TagGroupDto>>("api/config/groups") ?? new();
            _tags = await Http.GetFromJsonAsync<List<TagDto>>("api/config/tags") ?? new();
            _devices = await Http.GetFromJsonAsync<List<DeviceDto>>("api/config/devices") ?? new();
            _descriptors = await Http.GetFromJsonAsync<List<DriverDescriptor>>("api/config/driver-descriptors") ?? new();
        }
        catch (Exception ex) when (ApiResponseErrors.IsUnauthorized(ex))
        {
            return;   // reported centrally; the layout asks for the key
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load the tag database: {ex.Message}", Severity.Error);
            return;
        }

        if (_selectedGroupId != RootId && _groups.All(g => g.Id != _selectedGroupId))
            _selectedGroupId = RootId;
        BuildTree();
    }

    // --- tree ----------------------------------------------------------------

    private void BuildTree()
    {
        TreeItemData<string> Node(TagGroupDto g) => new()
        {
            Value = g.Id,
            Text = g.Name,
            Icon = Icons.Material.Filled.Folder,
            Expanded = true,
            Children = _groups.Where(c => c.ParentId == g.Id).OrderBy(c => c.Name)
                              .Select(Node).Cast<TreeItemData<string>>().ToList(),
        };

        _tree = new()
        {
            new TreeItemData<string>
            {
                Value = RootId,
                Text = "Tags",
                Icon = Icons.Material.Filled.AccountTree,
                Expanded = true,
                Children = _groups.Where(g => g.ParentId is null).OrderBy(g => g.Name)
                                  .Select(Node).Cast<TreeItemData<string>>().ToList(),
            },
        };
    }

    private void OnSelectGroup(string? value)
    {
        _selectedGroupId = value ?? RootId;
        _folderEdit = null;
        _tagEdit = null;
        _highlightTagId = null;
    }

    private string GroupPath(string groupId)
    {
        var byId = _groups.ToDictionary(g => g.Id);
        var parts = new List<string>();
        var visited = new HashSet<string>();
        for (var g = byId.GetValueOrDefault(groupId); g is not null && visited.Add(g.Id);
             g = g.ParentId is null ? null : byId.GetValueOrDefault(g.ParentId))
        {
            parts.Insert(0, g.Name);
        }
        return string.Join("/", parts);
    }

    private string CurrentPathLabel => _selectedGroupId == RootId ? "(root)" : GroupPath(_selectedGroupId);

    private IEnumerable<TagGroupDto> FolderChoicesExcludingSubtree(string? excludeId)
    {
        if (excludeId is null)
            return _groups.OrderBy(g => GroupPath(g.Id));

        var excluded = new HashSet<string> { excludeId };
        bool grew;
        do
        {
            grew = false;
            foreach (var g in _groups)
            {
                if (g.ParentId is not null && excluded.Contains(g.ParentId) && excluded.Add(g.Id))
                    grew = true;
            }
        } while (grew);
        return _groups.Where(g => !excluded.Contains(g.Id)).OrderBy(g => GroupPath(g.Id));
    }

    // --- folder CRUD ---------------------------------------------------------

    private void NewFolder()
    {
        _folderIsNew = true;
        _folderEdit = new TagGroupDto { Id = Guid.NewGuid().ToString("N"), Name = "" };
        _folderParentId = _selectedGroupId;
        _tagEdit = null;
    }

    private void EditFolder()
    {
        var g = _groups.FirstOrDefault(x => x.Id == _selectedGroupId);
        if (g is null) return;
        _folderIsNew = false;
        _folderEdit = new TagGroupDto { Id = g.Id, ParentId = g.ParentId, Name = g.Name };
        _folderParentId = g.ParentId ?? RootId;
        _tagEdit = null;
    }

    private async Task SaveFolderAsync()
    {
        if (_folderEdit is null) return;
        if (string.IsNullOrWhiteSpace(_folderEdit.Name)) { Snackbar.Add("Folder name is required.", Severity.Warning); return; }
        _folderEdit.ParentId = _folderParentId == RootId ? null : _folderParentId;

        _busy = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/config/groups/{_folderEdit.Id}", _folderEdit);
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Save failed: {await ApiResponseErrors.ReadAsync(resp)}", Severity.Error);
                return;
            }
            _selectedGroupId = _folderEdit.Id;
            _folderEdit = null;
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private async Task DeleteFolderAsync()
    {
        var path = CurrentPathLabel;
        var tagCount = _tags.Count(t => IsInSubtree(t.GroupId, _selectedGroupId));
        var ok = await Dialog.ShowMessageBoxAsync("Delete folder",
            $"Delete '{path}' including all sub-folders and {tagCount} tag(s) inside?",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;

        _busy = true;
        try
        {
            var resp = await Http.DeleteAsync($"api/config/groups/{_selectedGroupId}");
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Delete failed: {await ApiResponseErrors.ReadAsync(resp)}", Severity.Error);
                return;
            }
            _selectedGroupId = RootId;
            await LoadAsync();
            Snackbar.Add($"Deleted '{path}'. Click \"Apply to engine\" to make it live.", Severity.Info);
        }
        finally { _busy = false; }
    }

    private bool IsInSubtree(string? groupId, string rootId)
    {
        var byId = _groups.ToDictionary(g => g.Id);
        var visited = new HashSet<string>();
        for (var id = groupId; id is not null && visited.Add(id);
             id = byId.GetValueOrDefault(id)?.ParentId)
        {
            if (id == rootId)
                return true;
        }
        return false;
    }

    // --- tag CRUD ------------------------------------------------------------

    private IEnumerable<TagDto> TagsInSelectedGroup =>
        _tags.Where(t => (t.GroupId ?? RootId) == _selectedGroupId).OrderBy(t => t.Name);

    private void NewTag()
    {
        _tagIsNew = true;
        _tagEdit = new TagDto
        {
            Id = Guid.NewGuid().ToString("N"),
            // A gateway with no connection yet cannot have a device tag, so offer the kind that works.
            Kind = _devices.Count > 0 ? TagKind.Device : TagKind.Memory,
            DeviceId = _devices.FirstOrDefault()?.Id ?? "",
            Name = "",
            Address = "",
        };
        _tagGroupId = _selectedGroupId;
        _folderEdit = null;
        ClearExpressionCheck();
    }

    private async Task EditTag(TagDto t)
    {
        _tagIsNew = false;
        _tagEdit = new TagDto
        {
            Id = t.Id, GroupId = t.GroupId, DeviceId = t.DeviceId, Kind = t.Kind, Name = t.Name,
            Address = t.Address, DataType = t.DataType, Unit = t.Unit, Description = t.Description,
            Scale = t.Scale, Offset = t.Offset, Monotonic = t.Monotonic,
            AllowWrite = t.AllowWrite, WriteMin = t.WriteMin, WriteMax = t.WriteMax,
            ScanIntervalMs = t.ScanIntervalMs,
            Expression = t.Expression, InitialValue = t.InitialValue,
            Retentive = t.Retentive, EvalMode = t.EvalMode,
        };
        _tagGroupId = t.GroupId ?? RootId;
        _folderEdit = null;
        ClearExpressionCheck();

        // Show at once what the stored formula reads and what it evaluates to right now — a renamed
        // tag underneath an old formula is otherwise invisible until the next apply.
        if (t.Kind == TagKind.Expression && !string.IsNullOrWhiteSpace(t.Expression))
            await CheckExpressionAsync(t.Expression!);
    }

    private void ClearExpressionCheck()
    {
        _expressionError = null;
        _expressionReads = new();
        _expressionUnknown = new();
        _expressionPreview = null;
    }

    private async Task OnExpressionChanged(string? text)
    {
        if (_tagEdit is null) return;
        _tagEdit.Expression = text;
        ClearExpressionCheck();
        if (!string.IsNullOrWhiteSpace(text))
            await CheckExpressionAsync(text);
    }

    private async Task CheckExpressionAsync(string text)
    {
        try
        {
            var body = new { Expression = text };
            var check = await (await Http.PostAsJsonAsync("api/expressions/validate", body))
                .Content.ReadFromJsonAsync<ExpressionCheck>();
            if (check is null) return;

            if (!check.Valid)
            {
                _expressionError = $"{check.Error} (at character {check.Position + 1})";
                return;
            }
            _expressionReads = check.ReferencedTags;
            _expressionUnknown = check.UnknownTags;

            // Evaluating against the live values turns "it compiles" into "it gives this number",
            // which is the question the person writing the formula actually has.
            var result = await (await Http.PostAsJsonAsync("api/expressions/evaluate", body))
                .Content.ReadFromJsonAsync<ExpressionResult>();
            _expressionPreview = result is null ? null
                : result.Quality == Quality.Good ? result.Text
                : $"{result.Quality} — {result.Status}";
        }
        catch (Exception ex) when (ApiResponseErrors.IsUnauthorized(ex))
        {
            // Reported centrally; the formula simply stays unchecked until a key is entered.
        }
        catch (Exception ex)
        {
            _expressionError = ex.Message;
        }
    }

    private static string KindLabel(TagKind kind) => kind switch
    {
        TagKind.Memory => "Memory",
        TagKind.Expression => "Expression",
        _ => "Device",
    };

    private static Color KindColour(TagKind kind) => kind switch
    {
        TagKind.Memory => Color.Warning,
        TagKind.Expression => Color.Tertiary,
        _ => Color.Default,
    };

    private static string SourceText(TagDto t) => t.Kind switch
    {
        TagKind.Expression => t.Expression ?? "",
        TagKind.Memory => string.IsNullOrWhiteSpace(t.InitialValue)
            ? "(no initial value)"
            : $"= {t.InitialValue}" + (t.Retentive ? " · kept" : ""),
        _ => t.Address,
    };

    private const string KindHelp =
        "Device: read from a connection by a driver. Memory: holds whatever is written to it — a "
        + "setpoint, a mode, an operator note. Expression: computed from other tags by a formula.";

    private sealed class ExpressionCheck
    {
        public bool Valid { get; set; }
        public string? Error { get; set; }
        public int Position { get; set; }
        public List<string> ReferencedTags { get; set; } = new();
        public List<string> UnknownTags { get; set; } = new();
    }

    private sealed class ExpressionResult
    {
        public Quality Quality { get; set; }
        public string? Status { get; set; }
        public string Text { get; set; } = "";
    }

    private string PreviewPath
    {
        get
        {
            if (_tagEdit is null) return "";
            var folder = _tagGroupId == RootId ? "" : GroupPath(_tagGroupId);
            var name = string.IsNullOrWhiteSpace(_tagEdit.Name) ? "<name>" : _tagEdit.Name.Trim();
            return folder.Length == 0 ? name : $"{folder}/{name}";
        }
    }

    private const string ScanRateHelp =
        "How often to read this one tag. 0 (the normal case) means it is read on every scan of its "
        + "connection. Set it slower for values that change rarely — a daily energy total, a "
        + "nameplate register — to save bandwidth and PLC time on a metered or congested link. "
        + "Faster than the connection's own interval has no effect: that interval is the clock "
        + "everything ticks on. A slower rate also delays noticing the device has died, by at most "
        + "the slowest rate on that connection.";

    /// <summary>The connection's interval is the floor, so say so when the tag asks for less.</summary>
    private string ConnectionRateNote
    {
        get
        {
            var device = _devices.FirstOrDefault(d => d.Id == _tagEdit?.DeviceId);
            if (device is null || _tagEdit is null || _tagEdit.ScanIntervalMs <= 0)
                return "";
            return _tagEdit.ScanIntervalMs < device.ScanIntervalMs
                ? $" — but the connection scans every {FormatRate(device.ScanIntervalMs)}, so that is the real rate"
                : "";
        }
    }

    // Written as if/else, not a switch expression: Razor's parser reads a relational pattern's
    // leading '<' as the start of an HTML tag and the whole @code block stops compiling.
    private static string FormatRate(int ms)
    {
        if (ms < 1000) return $"{ms} ms";
        if (ms < 60_000) return $"{ms / 1000.0:0.##} s";
        if (ms < 3_600_000) return $"{ms / 60_000.0:0.##} min";
        return $"{ms / 3_600_000.0:0.##} h";
    }

    private async Task SaveTagAsync()
    {
        if (_tagEdit is null) return;
        if (string.IsNullOrWhiteSpace(_tagEdit.Name)) { Snackbar.Add("Tag name is required.", Severity.Warning); return; }
        if (_tagEdit.Kind == TagKind.Device && string.IsNullOrWhiteSpace(_tagEdit.DeviceId))
        { Snackbar.Add("Pick the connection this tag reads from.", Severity.Warning); return; }
        if (_tagEdit.Kind == TagKind.Expression && string.IsNullOrWhiteSpace(_tagEdit.Expression))
        { Snackbar.Add("An expression tag needs a formula.", Severity.Warning); return; }
        _tagEdit.GroupId = _tagGroupId == RootId ? null : _tagGroupId;

        _busy = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/config/tags/{_tagEdit.Id}", _tagEdit);
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Save failed: {await ApiResponseErrors.ReadAsync(resp)}", Severity.Error);
                return;
            }
            _tagEdit = null;
            await LoadAsync();
            Snackbar.Add("Saved. Click \"Apply to engine\" to make it live.", Severity.Success);
        }
        finally { _busy = false; }
    }

    private async Task DeleteTagAsync(TagDto t)
    {
        _busy = true;
        try
        {
            var resp = await Http.DeleteAsync($"api/config/tags/{t.Id}");
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Delete failed: {await ApiResponseErrors.ReadAsync(resp)}", Severity.Error);
                return;
            }
            await LoadAsync();
            Snackbar.Add($"Deleted '{t.Path}'. Click \"Apply to engine\" to make it live.", Severity.Info);
        }
        finally { _busy = false; }
    }

    // --- apply ---------------------------------------------------------------

    private async Task ApplyAsync()
    {
        _busy = true;
        try
        {
            var resp = await Http.PostAsync("api/config/reload", null);
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Apply failed: {await ApiResponseErrors.ReadAsync(resp)}", Severity.Error);
                return;
            }
            Connections.ReportApply(Snackbar, await resp.Content.ReadFromJsonAsync<Connections.ApplyResult>());
        }
        finally { _busy = false; }
    }
