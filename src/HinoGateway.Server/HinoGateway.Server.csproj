<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK treats every .json in the project as content and copies it to the output. For the
         live project file that is actively harmful: it produces a second configuration next to the
         binaries, and which one wins then depends on the working directory the gateway was started
         from — two copies silently drifting apart is the last thing a gateway in the field needs.
         The project file belongs beside the running application and is created there on first run. -->
    <Content Remove="hino.json" />
    <Content Remove="hino.json.bak" />
    <None Include="hino.json" CopyToOutputDirectory="Never" Condition="Exists('hino.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HinoGateway.Core\HinoGateway.Core.csproj" />
    <ProjectReference Include="..\HinoGateway.Engine\HinoGateway.Engine.csproj" />
    <ProjectReference Include="..\HinoGateway.Drivers.Simulator\HinoGateway.Drivers.Simulator.csproj" />
    <ProjectReference Include="..\HinoGateway.Web\HinoGateway.Web.csproj" />
    <ProjectReference Include="..\HinoGateway.Storage\HinoGateway.Storage.csproj" />
    <ProjectReference Include="..\HinoGateway.Drivers.Modbus\HinoGateway.Drivers.Modbus.csproj" />
    <ProjectReference Include="..\HinoGateway.Northbound.Iec104\HinoGateway.Northbound.Iec104.csproj" />
  </ItemGroup>

</Project>
