      <Storage></Storage>
      <Tasks>
        <Task>
          <Storage>
            <Group Name="&#x9;General">
              <Property Name="Name">
                <Value xsi:type="xsd:string">Calulatecontrolvalue</Value>
              </Property>
              <Property Name="Description">
                <Value xsi:type="xsd:string"></Value>
              </Property>
              <Property Name="Enabled">
                <Value xsi:type="xsd:boolean">false</Value>
              </Property>
            </Group>
            <Group Name="&#x9;Schedule">
              <Property Name="Cycle">
                <Value xsi:type="xsd:int">0</Value>
              </Property>
            </Group>
            <Group Name="&#x9;Scripting">
              <Property Name="Expression">
                <Value xsi:type="xsd:string">var enabledNode = Node("/Control/EnabledControlPower");
var enabled     = (bool)XTagEx.EngValue(enabledNode, false);
if(!enabled) return;

var nodeEVN  = Node("/INTMemory/EVNActivePower");
var EVNPower = nodeEVN?.Value?.Engineering;
   
var nodeSolar  = Node("/INTMemory/SolarActivePower");
var SolarPower = nodeSolar?.Value?.Engineering;
var nodeGrid   = Node("/INTMemory/GridActivePower");
var GridPower  = nodeGrid?.Value?.Engineering;
var totalPower = SolarPower-GridPower+EVNPower;
var node1      = Node("/INTMemory/Controlvalue");
node1?.Write(totalPower);</Value>
              </Property>
            </Group>
          </Storage>
        </Task>
      </Tasks>
    </RootScripting>
