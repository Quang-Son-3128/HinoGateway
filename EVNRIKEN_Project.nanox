                  </Property>
                  <Property Name="ReadOnly">
                    <Value xsi:type="xsd:boolean">false</Value>
                  </Property>
                  <Property Name="FormatString">
                    <Value xsi:type="xsd:string"></Value>
                  </Property>
                  <Property Name="Expression">
                    <Value xsi:type="xsd:string">return
    - XTagEx.EngValue(Node("/PowerMeter/GridActivePower"), 0);</Value>
                  </Property>
                  <Property Name="ScanRate">
                    <Value xsi:type="xsd:unsignedInt">100</Value>
                  </Property>
