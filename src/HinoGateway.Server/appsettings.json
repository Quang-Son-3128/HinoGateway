{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "File": {
      "Directory": "logs",
      "RetainedFileCountLimit": 14,
      "FileSizeLimitMb": 32
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:2000"
      }
    }
  },
  "Security": {
    "Enabled": false,
    "RequireHttps": true,
    "ApiKeys": []
  },
  "AllowedHosts": "*"
}
