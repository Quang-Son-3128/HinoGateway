@page "/connections"
@page "/config"
@using System.Net.Http.Json
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>HinoGateway — Connections</PageTitle>

<div class="page-head">
    <h1>Connections</h1>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="NewDevice">New connection</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
               OnClick='() => Nav.NavigateTo("api/config/export", forceLoad: true)'>Export</MudButton>
    <MudButton HtmlTag="label" for="importFile" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload">Import</MudButton>
    <InputFile id="importFile" OnChange="OnImportFile" hidden accept=".hino,application/json" />
    <MudTooltip Text="Delete the whole existing configuration before importing">
        <MudSwitch T="bool" @bind-Value="_replaceOnImport" Color="Color.Warning" Label="replace" />
    </MudTooltip>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PublishedWithChanges"
               OnClick="ApplyAsync" Disabled="_busy">Apply to engine</MudButton>
</div>

<MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.65">
    Each connection is one device/link the gateway polls. Tags are organised separately on the
    <MudLink Href="tags">Tag Database</MudLink> page, where every tag picks the connection it reads from.
</MudText>

<MudPaper Elevation="0" Outlined Class="mb-4">
    <MudTable Items="_devices" Dense Hover Elevation="0">
        <HeaderContent>
            <MudTh Style="width:8rem">Status</MudTh>
            <MudTh>Connection Id</MudTh>
            <MudTh>Driver</MudTh>
            <MudTh>Endpoint</MudTh>
            <MudTh Style="text-align:right">Scan (ms)</MudTh>
            <MudTh Style="text-align:right">Tags</MudTh>
            <MudTh Style="text-align:right">Errors</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            @{
                var h = _health.GetValueOrDefault(context.Id);
            }
            <MudTd DataLabel="Status">
                <span class="d-inline-flex align-center" style="gap:.4rem">
                    <span class="led @StateLed(h?.State)"></span>
                    <span class="mono" style="font-size:.75rem;opacity:.8">@(h?.State.ToString().ToUpperInvariant() ?? "—")</span>
                </span>
            </MudTd>
            <MudTd DataLabel="Connection Id" Class="mono">@context.Id</MudTd>
            <MudTd DataLabel="Driver">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@context.Driver</MudChip>
            </MudTd>
            <MudTd DataLabel="Endpoint">
                <span class="mono" style="font-size:.8rem;opacity:.75">@Endpoint(context)</span>
            </MudTd>
            <MudTd DataLabel="Scan" Style="text-align:right" Class="mono">@context.ScanIntervalMs</MudTd>
            <MudTd DataLabel="Tags" Style="text-align:right" Class="mono">@context.Tags.Count</MudTd>
            <MudTd DataLabel="Errors" Style="text-align:right">
                @if (h is not null && !string.IsNullOrEmpty(h.LastError) && h.State != DeviceState.Connected)
                {
                    <MudTooltip Text="@h.LastError">
                        <span class="mono" style="color:var(--hino-bad);font-size:.8rem">@h.ErrorCount</span>
                    </MudTooltip>
                }
                else
                {
                    <span class="mono" style="opacity:.5;font-size:.8rem">@(h?.ErrorCount ?? 0)</span>
                }
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="() => Edit(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4" Style="opacity:.5">No connections configured.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@if (_edit is not null)
{
    <MudPaper Class="pa-4 mb-6" Elevation="0" Outlined Style="border-left:3px solid var(--mud-palette-primary)">
        <MudText Typo="Typo.h6" Class="mb-3">
            <MudIcon Icon="@(_isNew ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)" Size="Size.Small" Class="me-1" />
            @(_isNew ? "New connection" : $"Edit {_edit.Id}")
        </MudText>

        @{
            var descriptor = Descriptor(_edit.Driver);
            var declared = descriptor.Settings;
            var basic = declared.Where(s => !s.Advanced).ToList();
            var advanced = declared.Where(s => s.Advanced).ToList();
        }

        <div class="d-flex flex-wrap" style="gap:1rem">
            <MudTextField T="string" @bind-Value="_edit.Id" Label="Connection Id" Disabled="@(!_isNew)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:14rem" />
            <MudSelect T="string" @bind-Value="_edit.Driver" @bind-Value:after="OnDriverChanged" Label="Driver"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:14rem">
                @foreach (var drv in _descriptors)
                {
                    <MudSelectItem T="string" Value="@drv.DriverType">@DriverLabel(drv)</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="int" @bind-Value="_edit.ScanIntervalMs" Label="Scan interval (ms)" Min="50"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:10rem" />
            <MudNumericField T="int" @bind-Value="_edit.FailureThreshold" Label="Failures before reconnect"
                             Min="1" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Style="min-width:13rem" HelperText="Fatal link errors still reconnect immediately" />
        </div>

        @if (!string.IsNullOrWhiteSpace(descriptor.Description))
        {
            <MudText Typo="Typo.body2" Class="mt-2" Style="opacity:.7">@descriptor.Description</MudText>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Settings</MudText>

        @* Every box below comes from the driver's own descriptor, so a new driver arrives with its
           parameters already on screen instead of leaving the operator to guess the key names. *@
        @if (basic.Count > 0)
        {
            <div class="d-flex flex-wrap align-start" style="gap:1rem">
                @foreach (var setting in basic)
                {
                    <DriverSettingField Setting="setting" Value="@ValueOf(setting)"
                                        ValueChanged="@(v => SetValue(setting, v))"
                                        Style="min-width:14rem;flex:0 1 16rem" />
                }
            </div>
        }

        @if (advanced.Count > 0)
        {
            <MudExpansionPanels Elevation="0" Class="mt-3" Dense>
                <MudExpansionPanel Text="@($"Tuning ({advanced.Count} optional)")">
                    <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.6">
                        Left blank, each keeps the driver's default shown in the box.
                    </MudText>
                    <div class="d-flex flex-wrap align-start" style="gap:1rem">
                        @foreach (var setting in advanced)
                        {
                            <DriverSettingField Setting="setting" Value="@ValueOf(setting)"
                                                ValueChanged="@(v => SetValue(setting, v))"
                                                Style="min-width:14rem;flex:0 1 16rem" />
                        }
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @* A driver that describes nothing, and any leftover key the current driver does not declare,
           still has to be editable — otherwise upgrading a driver would strand a saved setting with
           no way to see or remove it. *@
        @if (declared.Count == 0 || _extra.Count > 0)
        {
            @if (declared.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense Variant="Variant.Outlined" Class="mt-3">
                    @($"{_extra.Count} setting(s) below are not declared by {descriptor.DriverType}. The gateway refuses unknown settings — remove them or fix the spelling.")
                </MudAlert>
            }
            <MudSimpleTable Dense Bordered Elevation="0" Class="mt-2" Style="background:transparent">
                <thead><tr><th style="width:16rem">Key</th><th>Value</th><th style="width:3rem"></th></tr></thead>
                <tbody>
                    @foreach (var row in _extra)
                    {
                        <tr>
                            <td><MudTextField T="string" @bind-Value="row.Key" Margin="Margin.Dense" Variant="Variant.Text" Placeholder="Host" /></td>
                            <td><MudTextField T="string" @bind-Value="row.Value" Margin="Margin.Dense" Variant="Variant.Text" Placeholder="127.0.0.1" /></td>
                            <td><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="() => _extra.Remove(row)" /></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="() => _extra.Add(new SettingRow())">Add setting</MudButton>
        }

        @if (!string.IsNullOrWhiteSpace(descriptor.AddressSyntaxHelp))
        {
            <MudAlert Severity="Severity.Info" Dense Class="mt-3" Variant="Variant.Outlined">
                <b>Tag addresses for this driver:</b> @descriptor.AddressSyntaxHelp
                @if (descriptor.AddressExamples.Count > 0)
                {
                    <span> e.g. </span>
                    @for (var i = 0; i < descriptor.AddressExamples.Count; i++)
                    {
                        @if (i > 0)
                        {
                            <span>, </span>
                        }
                        <code>@descriptor.AddressExamples[i]</code>
                    }
                }
            </MudAlert>
        }

        <div class="d-flex mt-4" style="gap:.6rem">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
            <MudButton Variant="Variant.Text" OnClick="() => _edit = null">Cancel</MudButton>
        </div>
    </MudPaper>
}

@code {
    private List<DeviceDto> _devices = new();
    private List<DriverDescriptor> _descriptors = new();
    private Dictionary<string, DeviceHealth> _health = new();
    private System.Threading.Timer? _healthTimer;
    private DeviceDto? _edit;

    /// <summary>Values for the settings the selected driver declares, keyed by setting key.</summary>
    private readonly Dictionary<string, string> _values = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Keys the driver does not declare: a free-form driver, or a leftover from an old one.</summary>
    private readonly List<SettingRow> _extra = new();

    /// <summary>Which driver the values in <see cref="_values"/> were entered against.</summary>
    private string _previousDriver = "";

    private bool _isNew;
    private bool _busy;
    private bool _replaceOnImport;

    private sealed class SettingRow
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDriversAsync();
        await LoadDevicesAsync();
        _healthTimer = new System.Threading.Timer(_ => InvokeAsync(RefreshHealthAsync), null, 0, 3000);
    }

    private async Task RefreshHealthAsync()
    {
        try
        {
            var rows = await Http.GetFromJsonAsync<List<DeviceHealth>>("api/health") ?? new();
            _health = rows.ToDictionary(h => h.DeviceId);
            StateHasChanged();
        }
        catch { /* server briefly unreachable — keep last known */ }
    }

    private static string StateLed(DeviceState? s) => s switch
    {
        DeviceState.Connected => "led-good",
        DeviceState.Connecting => "led-warn",
        DeviceState.Faulted => "led-bad",
        _ => "led-idle",
    };

    // Compact endpoint summary for the table, rendered from the driver's own template — an S7
    // connection shows its rack and slot without this page knowing what a rack is.
    private string Endpoint(DeviceDto d)
    {
        var text = Descriptor(d.Driver).FormatEndpoint(d.Settings);
        return string.IsNullOrWhiteSpace(text) ? "(internal)" : text;
    }

    private DriverDescriptor Descriptor(string? driver) =>
        _descriptors.FirstOrDefault(x => string.Equals(x.DriverType, driver, StringComparison.OrdinalIgnoreCase))
        ?? DriverDescriptor.Minimal(driver ?? "");

    private static string DriverLabel(DriverDescriptor d) =>
        string.IsNullOrWhiteSpace(d.DisplayName) ? d.DriverType : d.DisplayName;

    public void Dispose() => _healthTimer?.Dispose();

    private async Task LoadDevicesAsync()
    {
        _devices = await Http.GetFromJsonAsync<List<DeviceDto>>("api/config/devices") ?? new();
    }

    /// <summary>
    /// The driver list is the descriptor list: names, settings and address syntax arrive together so
    /// the editor never has to hard-code a protocol. A server too old to describe its drivers still
    /// yields a working, free-form editor via <see cref="DriverDescriptor.Minimal"/>.
    /// </summary>
    private async Task LoadDriversAsync()
    {
        try
        {
            _descriptors = await Http.GetFromJsonAsync<List<DriverDescriptor>>("api/config/driver-descriptors") ?? new();
        }
        catch
        {
            var names = await Http.GetFromJsonAsync<List<string>>("api/config/drivers") ?? new();
            _descriptors = names.Select(DriverDescriptor.Minimal).ToList();
        }
    }

    private void NewDevice()
    {
        _isNew = true;
        _edit = new DeviceDto { Driver = _descriptors.FirstOrDefault()?.DriverType ?? "Simulator" };
        _values.Clear();
        _extra.Clear();
        _previousDriver = "";
        OnDriverChanged();
    }

    private void Edit(DeviceDto d)
    {
        _isNew = false;
        _edit = new DeviceDto
        {
            Id = d.Id,
            Driver = d.Driver,
            ScanIntervalMs = d.ScanIntervalMs,
            FailureThreshold = d.FailureThreshold,
            Settings = new(d.Settings),
        };

        var descriptor = Descriptor(d.Driver);
        _previousDriver = d.Driver;
        _values.Clear();
        _extra.Clear();
        foreach (var kv in d.Settings)
        {
            if (descriptor.Knows(kv.Key)) _values[kv.Key] = kv.Value;
            else _extra.Add(new SettingRow { Key = kv.Key, Value = kv.Value });
        }
    }

    /// <summary>
    /// Lay out the newly chosen driver's own parameters, pre-filled with its defaults.
    ///
    /// <para>
    /// What the operator actually typed survives the switch when the new driver declares the same
    /// key — a Host is a Host. A value still sitting at the <em>old</em> driver's default does not:
    /// carrying Modbus's port 502 over to an S7 connection that speaks on 102 hands the operator a
    /// form that looks filled in and cannot connect.
    /// </para>
    /// </summary>
    private void OnDriverChanged()
    {
        if (_edit is null) return;
        var previous = Descriptor(_previousDriver);
        var descriptor = Descriptor(_edit.Driver);
        _previousDriver = _edit.Driver;

        var kept = _values
            .Where(kv => descriptor.Knows(kv.Key))
            .Where(kv => !string.Equals(kv.Value, previous.Setting(kv.Key)?.Default, StringComparison.Ordinal))
            .ToList();
        _values.Clear();
        foreach (var kv in kept)
            _values[kv.Key] = kv.Value;
        _extra.Clear();

        // Only the everyday settings are pre-filled: writing every tuning knob into the project as
        // an explicit copy of its default would freeze today's defaults into every connection.
        foreach (var setting in descriptor.Settings.Where(s => !s.Advanced && !s.IsSecret))
            if (!_values.ContainsKey(setting.Key) && !string.IsNullOrWhiteSpace(setting.Default))
                _values[setting.Key] = setting.Default!;

        if (_isNew && descriptor.DefaultScanIntervalMs > 0)
            _edit.ScanIntervalMs = descriptor.DefaultScanIntervalMs;
    }

    private string ValueOf(DriverSetting setting) => _values.GetValueOrDefault(setting.Key, "");

    private void SetValue(DriverSetting setting, string value)
    {
        if (string.IsNullOrWhiteSpace(value)) _values.Remove(setting.Key);
        else _values[setting.Key] = value.Trim();
    }

    private async Task SaveAsync()
    {
        if (_edit is null) return;
        if (string.IsNullOrWhiteSpace(_edit.Id)) { Snackbar.Add("Connection Id is required.", Severity.Warning); return; }

        var descriptor = Descriptor(_edit.Driver);

        // Say what is wrong here rather than letting the operator discover it as a rejected save:
        // these are the very rules the server validates with.
        var problems = descriptor.Settings
            .Select(s => new { s, error = DriverSettingField.Validate(s, ValueOf(s)) })
            .Where(x => x.error is not null)
            .Select(x => $"{x.s.Label ?? x.s.Key}: {x.error}")
            .ToList();
        if (problems.Count > 0)
        {
            foreach (var problem in problems.Take(4))
                Snackbar.Add(problem, Severity.Warning);
            return;
        }

        var settings = new Dictionary<string, string>();
        foreach (var setting in descriptor.Settings)
        {
            var value = ValueOf(setting);
            if (!string.IsNullOrWhiteSpace(value)) settings[setting.Key] = value.Trim();
        }
        foreach (var row in _extra.Where(r => !string.IsNullOrWhiteSpace(r.Key)))
            settings[row.Key.Trim()] = row.Value ?? "";
        _edit.Settings = settings;

        _busy = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/config/devices/{_edit.Id.Trim()}", _edit);
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Save failed: {await resp.Content.ReadAsStringAsync()}", Severity.Error);
                return;
            }
            _edit = null;
            await LoadDevicesAsync();
            Snackbar.Add("Saved. Click \"Apply to engine\" to make it live.", Severity.Success);
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(DeviceDto d)
    {
        _busy = true;
        try
        {
            var resp = await Http.DeleteAsync($"api/config/devices/{d.Id}");
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add(await resp.Content.ReadAsStringAsync(), Severity.Warning);
                return;
            }
            await LoadDevicesAsync();
            Snackbar.Add($"Deleted {d.Id}. Click \"Apply to engine\" to make it live.", Severity.Info);
        }
        finally { _busy = false; }
    }

    private async Task OnImportFile(InputFileChangeEventArgs e)
    {
        if (e.FileCount == 0) return;
        _busy = true;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(20 * 1024 * 1024));
            var json = await reader.ReadToEndAsync();
            var content = new StringContent(json, Encoding.UTF8, "application/json");
            var resp = await Http.PostAsync($"api/config/import?replace={_replaceOnImport.ToString().ToLowerInvariant()}", content);
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Import failed: {await resp.Content.ReadAsStringAsync()}", Severity.Error);
                return;
            }
            var result = await resp.Content.ReadFromJsonAsync<ImportResult>();
            await LoadDevicesAsync();
            Snackbar.Add($"Imported {result?.Devices ?? 0} connection(s), {result?.Groups ?? 0} folder(s), {result?.Tags ?? 0} tag(s), {result?.Alarms ?? 0} alarm(s). Click \"Apply to engine\".", Severity.Success);
        }
        finally { _busy = false; }
    }

    private sealed record ImportResult(int Devices, int Groups, int Tags, int Alarms, int Removed);

    private async Task ApplyAsync()
    {
        _busy = true;
        try
        {
            var response = await Http.PostAsync("api/config/reload", null);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Apply failed: {await ApiResponseErrors.ReadAsync(response)}", Severity.Error);
                return;
            }
            ReportApply(Snackbar, await response.Content.ReadFromJsonAsync<ApplyResult>());
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// What the engine did with the configuration. Reconstructed 2026-08-10; mirrors
    /// <c>EngineApplyResult</c> on the server.
    /// </summary>
    public sealed class ApplyResult
    {
        public int Started { get; set; }
        public List<RejectedConnection> Rejected { get; set; } = new();
        public List<DroppedTag> DroppedTags { get; set; } = new();

        public sealed class RejectedConnection
        {
            public string DeviceId { get; set; } = "";
            public string? LastError { get; set; }
        }

        public sealed class DroppedTag
        {
            public string DeviceId { get; set; } = "";
            public string TagId { get; set; } = "";
            public string Reason { get; set; } = "";
        }
    }

    /// <summary>
    /// Say what actually happened, not "Applied".
    ///
    /// <para>
    /// An apply can succeed as an HTTP call while refusing a connection or dropping a tag, and an
    /// unconditional green message taught operators to ignore the one screen that would have told
    /// them a tag stopped being read. Shared with the Tags page so both report it the same way.
    /// </para>
    /// </summary>
    public static void ReportApply(ISnackbar snackbar, ApplyResult? result)
    {
        if (result is null)
        {
            snackbar.Add("Applied.", Severity.Success);
            return;
        }

        foreach (var rejected in result.Rejected)
            snackbar.Add($"Connection '{rejected.DeviceId}' is not running: {rejected.LastError}", Severity.Error);
        foreach (var dropped in result.DroppedTags)
            snackbar.Add($"Tag '{dropped.TagId}' was dropped: {dropped.Reason}", Severity.Warning);

        if (result.Rejected.Count == 0 && result.DroppedTags.Count == 0)
            snackbar.Add($"Applied — {result.Started} connection(s) running.", Severity.Success);
    }
}
