<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HinoGateway.Core\HinoGateway.Core.csproj" />
    <ProjectReference Include="..\HinoGateway.Expressions\HinoGateway.Expressions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Must track the target framework: a net8 application pulling in the 10.x abstractions was
         asking for a runtime assembly-version conflict on machines with only the 8.x runtime. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
