            <Tag>
              <Storage>
                <Group Name="&#x9;General">
                  <Property Name="Name">
                    <Value xsi:type="xsd:string">Inv1EnergyYesterday</Value>
                  </Property>
                  <Property Name="Description">
                    <Value xsi:type="xsd:string"></Value>
                  </Property>
                  <Property Name="Enabled">
                    <Value xsi:type="xsd:boolean">true</Value>
                  </Property>
                </Group>
                <Group Name="&#x9;Value">
                  <Property Name="ValueSource">
                    <Value xsi:type="xsd:int">2</Value>
                  </Property>
                  <Property Name="DataType">
                    <Value xsi:type="xsd:int">8</Value>
                  </Property>
                  <Property Name="ReadOnly">
                    <Value xsi:type="xsd:boolean">false</Value>
                  </Property>
                  <Property Name="FormatString">
                    <Value xsi:type="xsd:string"></Value>
                  </Property>
                  <Property Name="Expression">
                    <Value xsi:type="xsd:string">var node      = Node("/Inverter/Inv1Energy");
var nodeValue = XTagEx.EngValue(node, null);
if(!float.TryParse(nodeValue?.ToString() ?? "", out float energy)) return 0;

var date = DateTime.Now.Date;
var vars = This.Vars;
vars.InitVar("date", date)
    .InitVar("start", energy)
    .InitVar("value", 0);
    
if(date != (DateTime)vars["date"])
{
    vars["value"] = energy - vars["start"];
    vars["date"] = date;
    vars["start"] = energy;
} 
return vars["value"];</Value>
                  </Property>
