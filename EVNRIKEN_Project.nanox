            <Command>
              <Storage>
                <Group Name="&#x9;General">
                  <Property Name="Name">
                    <Value xsi:type="xsd:string">SetControlPower</Value>
                  </Property>
                  <Property Name="Description">
                    <Value xsi:type="xsd:string"></Value>
                  </Property>
                </Group>
                <Group Name="&#x9;Scripting">
                  <Property Name="Expression">
                    <Value xsi:type="xsd:string">var modeNode = Node("/PLCControl/EnableEVNMode");
var enabled  = XTagEx.EngValue(modeNode, false);
if(enabled != true) return;

var countNode    = Node("/PLCControl/TotalInvOn");
var count        = countNode?.Value?.Engineering;
if(count==0) return;
var loadNode     = Node("/PLCControl/PLoad");
var load         = loadNode?.Value?.Engineering;
var grid         = Args["value"];
var setPowerNode = Node("/PLCControl/SettingPEVN");

var setPower = load + grid;
setPowerNode?.Write(setPower);</Value>
                  </Property>
                </Group>
                <Group Name="Custom"></Group>
              </Storage>
            </Command>
            <Command>
              <Storage>
                <Group Name="&#x9;General">
                  <Property Name="Name">
                    <Value xsi:type="xsd:string">SetControlPowerPercent</Value>
                  </Property>
                  <Property Name="Description">
                    <Value xsi:type="xsd:string"></Value>
                  </Property>
                </Group>
                <Group Name="&#x9;Scripting">
                  <Property Name="Expression">
                    <Value xsi:type="xsd:string">var modeNode = Node("/PLCControl/EnableEVNMode");
var enabled  = XTagEx.EngValue(modeNode, false);
if(enabled != true) return;

var percent  = (float)Args["value"];
var setPower = 165 * (percent / 100);

var setNode = Node("/PLCControl/SettingPEVN");
setNode?.Write(setPower);</Value>
                  </Property>
                </Group>
                <Group Name="Custom"></Group>
              </Storage>
            </Command>
          </Nodes>
        </Folder>
