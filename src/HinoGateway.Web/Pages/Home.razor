@page "/"
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject HinoGateway.Web.Security.ApiKeyStore ApiKeys
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@using HinoGateway.Web.Components

<PageTitle>HinoGateway — Live Data</PageTitle>

<div class="page-head">
    <h1>Live Data</h1>
    <MudChip T="string" Size="Size.Small"
             Color="@(Live ? Color.Success : Color.Error)"
             Icon="@(Live ? Icons.Material.Filled.Sensors : Icons.Material.Filled.SensorsOff)"
             Variant="Variant.Filled">
        @(Live ? "LIVE" : "OFFLINE")
    </MudChip>
    <MudSpacer />
    <MudText Typo="Typo.caption" Class="mono hino-muted">@(_feed?.UpdateCount ?? 0) updates received</MudText>
</div>

@foreach (var alarm in _components.Where(x => x.AlarmActive))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense Class="mb-2">
        <strong>@ComponentLabel(alarm.Name)</strong>: @alarm.AlarmReason
    </MudAlert>
}

<div class="kpi-row mb-4">
    <div class="kpi kpi-accent">
        <div class="kpi-label">Connections</div>
        <div class="kpi-value">@_health.Count(h => h.State == DeviceState.Connected)<span class="hino-muted" style="font-size:.8em">/@_health.Count</span></div>
        <div class="kpi-sub">connected / total</div>
    </div>
    <div class="kpi kpi-neutral">
        <div class="kpi-label">Tags</div>
        <div class="kpi-value">@_infos.Count</div>
        <div class="kpi-sub">configured</div>
    </div>
    <div class="kpi kpi-good">
        <div class="kpi-label">Good</div>
        <div class="kpi-value">@Samples.Count(v => v.Quality == Quality.Good)</div>
        <div class="kpi-sub">quality OK</div>
    </div>
    <div class="kpi kpi-bad">
        <div class="kpi-label">Bad / Uncertain</div>
        <div class="kpi-value">@Samples.Count(v => v.Quality != Quality.Good)</div>
        <div class="kpi-sub">needs attention</div>
    </div>
</div>

@if (_health.Count > 0)
{
    @* With many devices a card per device would bury the tag table — show cards for the
       troubled ones only and summarise the healthy rest. *@
    var cards = _health.Count <= 12
        ? _health.OrderBy(x => x.DeviceId).ToList()
        : _health.Where(h => h.State != DeviceState.Connected).OrderBy(x => x.DeviceId).Take(12).ToList();

    @if (_health.Count > 12)
    {
        <MudText Typo="Typo.caption" Class="mono d-block mb-2 hino-muted">
            @_health.Count(h => h.State == DeviceState.Connected)/@_health.Count connections healthy
            @(cards.Count > 0 ? " — showing troubled only:" : "")
        </MudText>
    }
    <div class="dev-row mb-4">
        @foreach (var h in cards)
        {
            <div class="dev-card">
                <div class="dev-head">
                    <span class="led @StateLed(h.State)"></span>
                    <span>@h.DeviceId</span>
                    <MudSpacer />
                    <span class="mono txt-xs hino-muted">@h.State.ToString().ToUpperInvariant()</span>
                </div>
                <div class="dev-stats">
                    <span title="Latency of the last successful poll">⏱ @FormatLatency(h.LastPollLatency)</span>
                    <span title="Successful polls">✓ @h.PollCount</span>
                    <span title="Errors">✗ @h.ErrorCount</span>
                </div>
                @if (!string.IsNullOrEmpty(h.LastError) && h.State != DeviceState.Connected)
                {
                    <MudTooltip Text="@h.LastError">
                        <div class="dev-error">@h.LastError</div>
                    </MudTooltip>
                }
            </div>
        }
    </div>
}

@if (_infos.Count == 0)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="my-4" />
}
else
{
    <MudPaper Elevation="0" Outlined Class="mb-4">
        <MudToolBar Dense Class="px-3" Style="gap:.6rem">
            <MudIcon Icon="@Icons.Material.Filled.TableRows" Size="Size.Small" Class="hino-muted" />
            <MudText Typo="Typo.subtitle2">Tag values</MudText>
            <MudText Typo="Typo.caption" Class="mono hino-muted">@_view.Count / @_infos.Count</MudText>
            <MudSpacer />
            <MudTextField T="string" @bind-Value="_filter" @bind-Value:after="OnFilterChanged"
                          Placeholder="Filter tags…" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small"
                          Margin="Margin.Dense" Variant="Variant.Outlined" Clearable Immediate
                          Style="max-width:16rem" />
        </MudToolBar>
        <MudTable Items="_view" Dense Hover Elevation="0" Class="hino-table"
                  Virtualize FixedHeader Height="56vh"
                  RowStyleFunc="RowStyle" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh Style="width:2rem"></MudTh>
                <MudTh>Tag ID</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Connection</MudTh>
                <MudTh>Description</MudTh>
                <MudTh Style="text-align:right">Value</MudTh>
                <MudTh>Quality</MudTh>
                <MudTh>Message</MudTh>
                <MudTh Style="text-align:right">Last change</MudTh>
                <MudTh Style="width:3rem"></MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    var s = _feed?.Sample(context.Id);
                    var has = s is not null;
                }
                <MudTd Style="width:2rem">
                    <span class="led @(has ? TelemetryFeed.QualityLed(s!.Quality) : "led-idle")"></span>
                </MudTd>
                <MudTd DataLabel="Tag ID">
                    <MudLink Href="@($"tags?select={Uri.EscapeDataString(context.Id)}")"
                             Class="mono txt-sm">@context.Id</MudLink>
                </MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Connection"><span class="mono txt-sm hino-dim">@context.DeviceId</span></MudTd>
                <MudTd DataLabel="Description" Class="txt-sm hino-dim">@context.Description</MudTd>
                <MudTd DataLabel="Value" Style="text-align:right">
                    <span class="tag-value @(has && TelemetryFeed.IsFresh(s!.LastChanged) ? "changed" : "")">
                        @(has ? TelemetryFeed.FormatValue(s!.Value) : "—")
                    </span>
                    <span class="txt-xs hino-muted">@context.Unit</span>
                </MudTd>
                <MudTd DataLabel="Quality">
                    @if (has)
                    {
                        <span class="mono txt-sm" style="color:@TelemetryFeed.QualityCss(s!.Quality)">@s.Quality.ToString().ToUpperInvariant()</span>
                    }
                </MudTd>
                <MudTd DataLabel="Message">
                    @if (has && !string.IsNullOrEmpty(s!.StatusText))
                    {
                        <MudTooltip Text="@s.StatusText">
                            <MudText Typo="Typo.caption" Color="@(s.Quality == Quality.Bad ? Color.Error : Color.Warning)"
                                     Class="hino-ellipsis d-block" Style="max-width:20rem">
                                @s.StatusText
                            </MudText>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd DataLabel="Last change" Style="text-align:right">
                    <span class="mono txt-sm hino-dim">@(has ? TelemetryFeed.FormatLastChanged(s!.LastChanged) : "")</span>
                </MudTd>
                <MudTd Style="text-align:right">
                    <MudTooltip Text="@($"Write a value to {context.Id}")">
                        <MudIconButton Icon="@Icons.Material.Filled.Output" Size="Size.Small"
                                       OnClick="@(() => OpenWriteAsync(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

}

@code {
    private readonly Dictionary<string, TagInfo> _infos = new();
    private List<TagInfo> _view = new();
    private List<DeviceHealth> _health = new();
    private List<ComponentHealthDto> _components = new();
    private TelemetryFeed? _feed;
    private System.Threading.Timer? _healthTimer;
    private string _filter = "";

    private bool Live => _feed?.IsConnected == true;

    private IEnumerable<TagSample> Samples => _feed?.Values.Values ?? Enumerable.Empty<TagSample>();

    // The visible list is cached and rebuilt only when the tag set or the filter changes —
    // sorting/filtering 10k tags on every render tick would waste the WASM main thread.
    private void RebuildView()
    {
        IEnumerable<TagInfo> q = _infos.Values;
        if (!string.IsNullOrWhiteSpace(_filter))
            q = q.Where(i =>
                i.Id.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || i.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || i.DeviceId.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || (i.Description?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false));
        _view = q.OrderBy(i => i.Id, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void OnFilterChanged() => RebuildView();

    /// <summary>Control action: write a value to this row's tag (the device rejects read-only points).</summary>
    private async Task OpenWriteAsync(TagInfo tag)
    {
        var parameters = new DialogParameters<WriteValueDialog>
        {
            { x => x.TagId, tag.Id },
            { x => x.Name, tag.Name },
            { x => x.Unit, tag.Unit },
            { x => x.CurrentValue, _feed?.Sample(tag.Id) is { } s ? TelemetryFeed.FormatValue(s.Value) : null },
        };

        var dialog = await Dialogs.ShowAsync<WriteValueDialog>("Write value", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string written })
            Snackbar.Add($"Wrote {written}", Severity.Success);
    }

    protected override async Task OnInitializedAsync()
    {
        var infos = await Http.GetFromJsonAsync<List<TagInfo>>("api/tags") ?? new();
        foreach (var i in infos)
            _infos[i.Id] = i;
        RebuildView();

        _healthTimer = new System.Threading.Timer(_ => InvokeAsync(RefreshHealthAsync), null, 0, 3000);

        _feed = new TelemetryFeed(Nav, ApiKeys, () => InvokeAsync(StateHasChanged));
        await _feed.StartAsync();
    }

    private async Task RefreshHealthAsync()
    {
        try
        {
            _health = await Http.GetFromJsonAsync<List<DeviceHealth>>("api/health") ?? new();
            _components = await Http.GetFromJsonAsync<List<ComponentHealthDto>>("api/health/components") ?? new();
            StateHasChanged();
        }
        catch { /* server briefly unreachable — keep last known */ }
    }

    /// <summary>
    /// The operator sees the part of the gateway that is in trouble, not the identifier the code
    /// keeps it under. "commands" on a red banner means nothing on a control room screen; "Command
    /// engine" is something a shift can act on or report.
    /// </summary>
    private static string ComponentLabel(string name) => name switch
    {
        "commands" => "Command engine",
        "control-commands" => "Command service",
        "audit-trail" => "Audit trail",
        "audit-writer" => "Audit writer",
        "alarm-journal" => "Alarm journal",
        "history-sampler" => "History sampler",
        "signalr-telemetry" => "Live data feed",
        "iec104" => "IEC-104 station",
        "mqtt" => "MQTT publisher",
        _ => name,
    };

    private static string StateLed(DeviceState s) => s switch
    {
        DeviceState.Connected => "led-good",
        DeviceState.Connecting => "led-warn",
        DeviceState.Faulted => "led-bad",
        _ => "led-idle",
    };

    private string RowStyle(TagInfo info, int _) =>
        _feed?.Sample(info.Id) is { Quality: Quality.Bad }
            ? "background:rgba(239,68,68,.06)"
            : "";

    private static string FormatLatency(TimeSpan? t) =>
        t is null ? "— ms" : $"{t.Value.TotalMilliseconds:0} ms";

    public async ValueTask DisposeAsync()
    {
        _healthTimer?.Dispose();
        if (_feed is not null)
            await _feed.DisposeAsync();
    }

    private sealed record ComponentHealthDto(
        string Name, bool Running, long Restarts, int RecentRestarts,
        DateTimeOffset LastHeartbeat, DateTimeOffset? LastFailure, string? LastError,
        bool Stale, bool RestartStorm, bool AlarmActive, string? AlarmReason,
        bool HeartbeatExpected = true);
}
